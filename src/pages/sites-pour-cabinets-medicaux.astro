---
import Badge from "@components/Badge.astro";
import Button from "@components/Button.astro";
import Card from "@components/Card.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Site vitrine pour cabinet médical — Informer et rassurer vos patients | Tudor Pop"
  description="Un site vitrine moderne pour votre cabinet médical : présenter vos soins, faciliter la prise de rendez-vous, afficher vos informations pratiques et rassurer vos patients."
>
  <main>
    <Section tone="cream" class="surface-grid overflow-hidden">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <Badge variant="green">Cabinets médicaux &amp; paramédicaux</Badge>
            <h1
              class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-6xl"
            >
              Une présence rassurante pour informer vos patients et faciliter les rendez-vous
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-tudor-deep/80">
              Vos patients cherchent des informations claires avant leur première consultation. Un site simple, professionnel et accessible leur donne confiance dès le départ.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <Button href="/contact">Demander ma démo</Button>
              <Button href="/offres" variant="outline">Voir les offres</Button>
            </div>
          </div>
          <Card variant="deep" class="relative overflow-hidden p-8">
            <div
              class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_80%_10%,rgba(255,196,157,0.2),transparent_30%)]"
            >
            </div>
            <div class="relative">
              <p class="text-sm font-black uppercase tracking-[0.16em] text-tudor-peach">
                Ce que vos patients recherchent
              </p>
              <div class="mt-6 grid gap-3">
                {
                  [
                    "Soins et spécialités présentés",
                    "Prise de rendez-vous facilitée",
                    "Informations pratiques claires",
                    "Adresse et accès visibles",
                    "Présence rassurante du praticien",
                  ].map((item) => (
                    <div class="flex items-center gap-3 rounded-lg border border-white/10 bg-tudor-dark/42 px-4 py-3">
                      <span class="h-2 w-2 shrink-0 rounded-full bg-tudor-peach" />
                      <span class="text-sm font-bold text-tudor-cream">{item}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          </Card>
        </div>
      </Container>
    </Section>

    <Section tone="soft">
      <Container>
        <div class="max-w-3xl">
          <Badge variant="green">Le problème</Badge>
          <h2 class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
            Ce que les patients ne trouvent pas facilement
          </h2>
          <p class="mt-5 text-lg leading-8 text-tudor-deep/80">
            Un nouveau patient qui vous cherche en ligne a des questions précises. Si les réponses ne sont pas là, il appelle ailleurs ou reporte sa démarche.
          </p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            [
              {
                title: "Spécialités floues",
                text: "Vos compétences et les soins proposés ne sont pas clairement présentés.",
              },
              {
                title: "Prise de RDV difficile",
                text: "Sans bouton de réservation ou lien Doctolib, le patient doit appeler en horaires de consultation.",
              },
              {
                title: "Infos pratiques manquantes",
                text: "Horaires, secteur conventionnel, moyens de paiement, accès handicapés… souvent introuvables.",
              },
              {
                title: "Absence de présentation",
                text: "Le praticien n'est pas présenté. Le patient ne sait pas à qui il va confier sa santé.",
              },
              {
                title: "Site inaccessible sur mobile",
                text: "La majorité des recherches se font sur smartphone. Un site non optimisé décourage.",
              },
              {
                title: "Pas de présence locale",
                text: "Sans site structuré, vous n'apparaissez pas bien dans les recherches Google de votre quartier.",
              },
            ].map((item) => (
              <Card interactive>
                <h3 class="font-display text-lg font-black text-tudor-dark">{item.title}</h3>
                <p class="mt-3 leading-7 text-tudor-deep/78">{item.text}</p>
              </Card>
            ))
          }
        </div>
      </Container>
    </Section>

    <Section tone="deep" class="overflow-hidden">
      <Container>
        <div class="max-w-3xl">
          <Badge variant="peach">Ce qu'un site vous apporte</Badge>
          <h2 class="mt-5 font-display text-4xl font-black leading-tight md:text-5xl">
            Votre cabinet mérite une présence à la hauteur
          </h2>
          <p class="mt-5 text-lg leading-8 text-tudor-cream/80">
            Un site bien conçu pour un cabinet médical, c'est une meilleure première impression, moins d'appels pour des informations basiques et des patients mieux préparés.
          </p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          {
            [
              {
                title: "Présenter votre parcours et vos soins",
                text: "Formation, spécialités, approche thérapeutique — des informations qui rassurent avant la première consultation.",
              },
              {
                title: "Faciliter la prise de rendez-vous",
                text: "Bouton vers Doctolib, formulaire de contact ou numéro en évidence selon votre organisation.",
              },
              {
                title: "Informations pratiques toujours accessibles",
                text: "Horaires, adresse, parking, accessibilité, secteur conventionnel et moyens de paiement.",
              },
              {
                title: "Être trouvé sur Google localement",
                text: "Structure SEO pensée pour apparaître sur « [spécialité] [votre ville] ».",
              },
            ].map((item) => (
              <article class="rounded-xl border border-white/12 bg-tudor-dark/42 p-6">
                <h3 class="font-display text-lg font-black text-tudor-cream">{item.title}</h3>
                <p class="mt-3 leading-7 text-tudor-cream/72">{item.text}</p>
              </article>
            ))
          }
        </div>
      </Container>
    </Section>

    <Section tone="cream">
      <Container>
        <div class="max-w-3xl">
          <Badge variant="green">Contenu recommandé</Badge>
          <h2 class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
            Ce que doit contenir votre site de cabinet médical
          </h2>
          <p class="mt-5 text-lg leading-8 text-tudor-deep/80">
            Chaque section joue un rôle précis pour informer, rassurer et faciliter la prise en charge.
          </p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            [
              {
                num: "01",
                title: "Présentation du praticien",
                text: "Diplômes, spécialités, expérience et approche. Pour que le patient sache à qui il s'adresse.",
              },
              {
                num: "02",
                title: "Soins et consultations",
                text: "Ce que vous traitez, comment se déroule une consultation et ce à quoi s'attendre.",
              },
              {
                num: "03",
                title: "Prise de rendez-vous",
                text: "Bouton Doctolib, lien de prise de contact ou formulaire selon votre organisation.",
              },
              {
                num: "04",
                title: "Informations pratiques",
                text: "Horaires, adresse, accès, secteur conventionnel, moyens de paiement, accessibilité.",
              },
              {
                num: "05",
                title: "Localisation",
                text: "Carte Google Maps intégrée, indications de stationnement et accès transports.",
              },
              {
                num: "06",
                title: "Questions fréquentes",
                text: "Répondre aux questions courantes pour réduire les appels et mieux préparer les patients.",
              },
            ].map((item) => (
              <Card interactive>
                <span class="font-display text-sm font-black text-tudor-peach">{item.num}</span>
                <h3 class="mt-3 font-display text-lg font-black text-tudor-dark">{item.title}</h3>
                <p class="mt-2 leading-7 text-tudor-deep/78">{item.text}</p>
              </Card>
            ))
          }
        </div>
      </Container>
    </Section>

    <Section tone="deep">
      <Container>
        <Card
          variant="green"
          class="grid gap-8 p-8 md:grid-cols-[1fr_auto] md:items-center md:p-10"
        >
          <div>
            <Badge variant="peach">Votre projet</Badge>
            <h2
              class="mt-5 font-display text-3xl font-black leading-tight text-tudor-cream md:text-4xl"
            >
              Voyez à quoi ressemblerait votre site avant de décider.
            </h2>
            <p class="mt-4 max-w-2xl text-lg leading-8 text-tudor-cream/82">
              Envoyez-moi le nom de votre cabinet et votre ville. Je prépare une démo concrète sans engagement.
            </p>
          </div>
          <Button href="/contact" size="lg">Demander ma démo</Button>
        </Card>
      </Container>
    </Section>

    <Section tone="soft">
      <Container>
        <p class="text-sm font-extrabold uppercase tracking-[0.14em] text-tudor-green">
          Autres secteurs
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <Button href="/sites-pour-garages" variant="outline" size="sm">Garages</Button>
          <Button href="/sites-pour-restaurants" variant="outline" size="sm">Restaurants</Button>
          <Button href="/sites-pour-commerces-locaux" variant="outline" size="sm">Commerces locaux</Button>
        </div>
      </Container>
    </Section>
  </main>
</BaseLayout>
