---
type Variant = "primary" | "secondary" | "outline" | "ghost" | "dark";
type Size = "sm" | "md" | "lg";
type ButtonType = "button" | "submit" | "reset";

type Props = {
  href?: string;
  variant?: Variant;
  size?: Size;
  type?: ButtonType;
  ariaLabel?: string;
  class?: string;
};

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  ariaLabel,
  class: className,
} = Astro.props;

const baseClasses =
  "inline-flex items-center justify-center gap-2 rounded-full font-extrabold transition duration-200 ease-out focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-4 focus-visible:outline-tudor-peach disabled:pointer-events-none disabled:opacity-55";

const variantClasses: Record<Variant, string> = {
  primary:
    "bg-tudor-peach text-tudor-deep shadow-[0_14px_34px_rgba(255,196,157,0.32)] hover:-translate-y-0.5 hover:bg-[#ffd2b6] hover:text-tudor-dark hover:shadow-[0_18px_38px_rgba(255,196,157,0.42)]",
  secondary:
    "border border-tudor-peach/85 bg-tudor-cream/10 text-tudor-cream hover:-translate-y-0.5 hover:bg-tudor-peach hover:text-tudor-deep",
  outline:
    "border-2 border-tudor-deep bg-transparent text-tudor-deep shadow-[0_10px_28px_rgba(6,79,70,0.08)] hover:-translate-y-0.5 hover:bg-tudor-deep hover:text-tudor-cream",
  ghost:
    "text-tudor-deep hover:bg-tudor-green/10 hover:text-tudor-dark",
  dark:
    "bg-tudor-dark text-tudor-cream shadow-[0_14px_34px_rgba(3,59,53,0.24)] hover:-translate-y-0.5 hover:bg-tudor-deep",
};

const sizeClasses: Record<Size, string> = {
  sm: "min-h-10 px-4 text-sm",
  md: "min-h-12 px-5 text-sm md:px-6",
  lg: "min-h-14 px-7 text-base",
};

const classes = [baseClasses, variantClasses[variant], sizeClasses[size], className];
---

{
  href ? (
    <a href={href} aria-label={ariaLabel} class:list={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} aria-label={ariaLabel} class:list={classes}>
      <slot />
    </button>
  )
}
