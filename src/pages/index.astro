---
import Badge from "@components/Badge.astro";
import Button from "@components/Button.astro";
import Card from "@components/Card.astro";
import ContactForm from "@components/ContactForm.astro";
import Container from "@components/Container.astro";
import IconFeature from "@components/IconFeature.astro";
import LocalTradesSection from "@components/LocalTradesSection.astro";
import Section from "@components/Section.astro";
import { siteConfig } from "../config/site";
import { contact } from "@data/contact";
import { faq } from "@data/faq";
import { maintenance, pricing } from "@data/pricing";
import { projects } from "@data/projects";
import BaseLayout from "@layouts/BaseLayout.astro";

const heroBadges = ["Démo avant engagement", "Design moderne", "SEO local", "Contact facilité"];

const problemCards = [
  "Site inexistant",
  "Image vieillissante",
  "Services peu clairs",
  "Contacts difficiles",
  "Manque de confiance",
  "Visibilité locale limitée",
];

const solutionFeatures = [
  {
    icon: "demo",
    title: "Démo avant engagement",
    description: "Vous voyez une première projection avant de vous engager.",
  },
  {
    icon: "design",
    title: "Design moderne",
    description: "Un site propre, clair et adapté à votre activité.",
  },
  {
    icon: "local",
    title: "SEO local",
    description: "Une structure pensée pour être trouvé dans votre ville.",
  },
  {
    icon: "contact",
    title: "Contact facilité",
    description: "Appel, formulaire, réservation ou itinéraire visibles au bon moment.",
  },
] as const;

const processSteps = [
  {
    title: "J'analyse votre activité",
    description: "Google Maps, avis, services, photos et concurrence locale.",
  },
  {
    title: "Je prépare une direction claire",
    description: "Message, image, structure et contenus utiles.",
  },
  {
    title: "Je crée une première démo",
    description: "Vous voyez concrètement ce que votre site peut devenir.",
  },
  {
    title: "On ajuste ensemble",
    description: "Textes, images, couleurs et appels à l'action.",
  },
  {
    title: "Je mets le site en ligne",
    description: "Site rapide, responsive, sécurisé et prêt à être partagé.",
  },
];

const differentiators = [
  {
    icon: "demo",
    title: "Vous voyez avant de décider",
    description: "La démo rend le projet concret dès le départ.",
  },
  {
    icon: "local",
    title: "Je parle le langage des clients locaux",
    description: "Pas de jargon ou de cahier technique compliqué.",
  },
  {
    icon: "contact",
    title: "Je pense image et contact",
    description: "Le site doit rassurer et déclencher l'appel, pas seulement être joli.",
  },
  {
    icon: "design",
    title: "Je personnalise vraiment",
    description: "Chaque vitrine part du métier, des avis, de la ville et des objectifs.",
  },
] as const;

const beforeAfter = [
  ["Une fiche Google seule", "Une vitrine claire"],
  ["Un site ancien", "Une image plus professionnelle"],
  ["Peu d'explications", "Des services mieux compris"],
  ["Une image floue", "Une confiance renforcée"],
  ["Des contacts qui se perdent", "Des appels plus faciles"],
];

const contactGoals = [
  "Avoir un site moderne",
  "Recevoir plus d'appels",
  "Améliorer mon image",
  "Présenter mes services",
  "Rediriger vers une réservation",
  "Être plus visible localement",
  "Voir une démo",
];

---

<BaseLayout>
  <main>
    <Section id="accueil" class="relative overflow-hidden bg-[radial-gradient(circle_at_82%_14%,rgba(255,196,157,0.28),transparent_26%),linear-gradient(135deg,var(--page-bg),var(--page-bg-soft))]">
      <Container>
        <div class="grid min-h-[calc(100vh-6rem)] items-center gap-12 py-8 lg:grid-cols-[0.94fr_1.06fr]">
          <div class="fade-up">
            <div class="mb-7 flex items-center gap-4">
              <span class="flex h-20 w-20 items-center justify-center rounded-full bg-white/80 shadow-[0_18px_42px_rgba(6,79,70,0.12)] ring-1 ring-tudor-green/12 sm:h-24 sm:w-24">
                <img
                  src="/assets/logo-tudor-pop-transparent.png"
                  alt="Logo Tudor Pop"
                  class="h-16 w-16 object-contain sm:h-20 sm:w-20"
                />
              </span>
              <Badge variant="peach"><span data-i18n="hero.eyebrow">Sites modernes pour professionnels locaux</span></Badge>
            </div>
            <h1 data-i18n="hero.title" class="mt-6 max-w-3xl font-display text-5xl font-black leading-[1.04] text-tudor-dark sm:text-6xl lg:text-7xl">
              Une vitrine qui travaille pour vous
            </h1>
            <p data-i18n="hero.subtitle" class="mt-6 max-w-2xl text-lg leading-8 text-tudor-deep/84 md:text-xl">
              Je crée des sites vitrines modernes qui donnent une image plus professionnelle aux commerces locaux, rassurent vos futurs clients et facilitent la prise de contact.
            </p>
            <div class="mt-7 flex flex-wrap gap-3" data-i18n-list="hero.badges">
              {heroBadges.map((badge) => <Badge><span data-i18n-item>{badge}</span></Badge>)}
            </div>
            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
              <Button href="#contact" size="lg"><span data-i18n="hero.primaryCta">Demander ma démo</span></Button>
              <Button href="#exemples" variant="dark" size="lg"><span data-i18n="hero.secondaryCta">Voir les exemples</span></Button>
            </div>
          </div>

          <div class="fade-up delay-2">
            <div class="relative rounded-lg border border-tudor-green/16 bg-white/72 p-4 shadow-[0_32px_90px_rgba(6,79,70,0.16)] backdrop-blur">
              <div class="relative overflow-hidden rounded-md bg-tudor-deep p-5 text-tudor-cream">
                <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_22%_18%,rgba(255,196,157,0.24),transparent_24%),radial-gradient(circle_at_82%_72%,rgba(14,143,120,0.38),transparent_30%)]"></div>
                <div class="relative flex items-center justify-between gap-4">
                  <div class="flex items-center gap-3">
                    <img src="/assets/logo-tudor-pop-transparent.png" alt="" class="h-14 w-14 rounded-full bg-tudor-cream object-contain p-1" />
                    <div>
                      <p class="font-display text-xl font-black">Tudor Pop</p>
                      <p class="text-sm font-bold text-tudor-peach">Vitrine locale</p>
                    </div>
                  </div>
                  <span class="hidden rounded-full bg-tudor-peach px-4 py-2 text-sm font-black text-tudor-dark sm:inline-flex">Demo</span>
                </div>
                <div class="relative mt-5 rounded-lg bg-tudor-cream/95 p-3 shadow-[0_22px_60px_rgba(3,59,53,0.22)]">
                  <img
                    src="/assets/la-vitrine-et-les-plus.png"
                    alt="Composition premium d'un site vitrine pour commerce local"
                    class="h-[20rem] w-full rounded-md object-contain sm:h-[25rem] lg:h-[30rem]"
                  />
                </div>
                <div class="relative mt-4 grid gap-3 text-sm font-black sm:grid-cols-4" data-i18n-list="hero.floating">
                  {["Plus visible", "Plus crédible", "Contact facilité", "SEO local"].map((item) => (
                    <span data-i18n-item class="rounded-full border border-tudor-peach/35 bg-tudor-dark/72 px-3 py-2 text-center text-tudor-cream">{item}</span>
                  ))}
                </div>
              </div>
              <img
                src="/assets/pub-1.png"
                alt="Aperçu secondaire d'une vitrine web moderne Tudor Pop"
                class="mt-4 h-28 w-full rounded-md object-cover object-center opacity-90 sm:h-36"
              />
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section id="probleme" tone="soft">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
          <div class="max-w-3xl">
            <Badge variant="green">Le vrai sujet</Badge>
            <h2 class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
              Vos clients vous regardent déjà en ligne
            </h2>
            <p class="mt-5 text-lg leading-8 text-tudor-deep/80">
              Avant d'appeler, réserver ou passer vous voir, vos futurs clients regardent votre image en ligne. Une fiche Google seule ne suffit pas toujours à rassurer, expliquer et donner envie.
            </p>
          </div>
          <Card variant="light" class="overflow-hidden p-4">
            <img
              src="/assets/site-internet.png"
              alt="Illustration d'un site internet clair pour une activité locale"
              class="h-64 w-full rounded-md object-cover object-center sm:h-80"
              loading="lazy"
            />
          </Card>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {problemCards.map((problem) => (
            <Card interactive>
              <div class="flex items-center gap-3">
                <span class="h-3 w-3 rounded-full bg-tudor-peach"></span>
                <h3 class="font-display text-xl font-black">{problem}</h3>
              </div>
            </Card>
          ))}
        </div>
      </Container>
    </Section>

    <Section id="solution" tone="deep" class="overflow-hidden">
      <Container>
        <div class="grid gap-12 lg:grid-cols-[0.86fr_1.14fr] lg:items-center">
          <div>
            <Badge variant="peach"><span data-i18n="solution.eyebrow">La solution</span></Badge>
            <h2 data-i18n="solution.title" class="mt-5 font-display text-4xl font-black leading-tight md:text-5xl">
              Une présence en ligne claire, crédible et facile à contacter
            </h2>
            <p data-i18n="solution.text" class="mt-5 text-lg leading-8 text-tudor-cream/78">
              Je construis une vitrine adaptée à votre métier, à votre ville et aux actions que vos clients doivent faire rapidement.
            </p>
            <div class="mt-8">
              <Button href="#contact"><span data-i18n="solution.cta">Voir ce que mon site pourrait donner</span></Button>
            </div>
          </div>

          <div class="grid gap-5">
            <Card variant="green" class="grid gap-6 p-5 md:grid-cols-[0.95fr_1.05fr] md:items-center">
              <div class="grid gap-4">
                {solutionFeatures.map((feature) => (
                  <div class="rounded-lg border border-white/14 bg-tudor-deep/40 p-4">
                    <IconFeature icon={feature.icon} title={feature.title} description={feature.description} tone="dark" />
                  </div>
                ))}
              </div>
              <div class="rounded-lg bg-tudor-cream p-4">
                <img
                  src="/assets/avantages-du-projet.png"
                  alt="Illustration des avantages d'un projet de site vitrine"
                  class="h-72 w-full rounded-md object-contain md:h-[34rem]"
                  loading="lazy"
                />
              </div>
            </Card>
          </div>
        </div>
      </Container>
    </Section>

    {siteConfig.showClientProjects ? (
    <Section id="exemples" tone="cream">
      <Container>
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div class="max-w-3xl">
            <Badge variant="green">Exemples et réalisations</Badge>
            <h2 class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
              Des exemples pensés pour de vrais professionnels locaux
            </h2>
            <p class="mt-5 text-lg leading-8 text-tudor-deep/80">
              Chaque démonstration part d'un métier, d'une ville et d'un objectif clair : rassurer plus vite et faciliter le contact.
            </p>
          </div>
          <Button href="/realisations" variant="outline">Toutes les réalisations</Button>
        </div>

        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {projects.map((project) => (
            <Card variant="light" interactive class="flex h-full flex-col">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <Badge variant="outline">{project.sector}</Badge>
                  <h3 class="mt-4 font-display text-2xl font-black leading-tight text-tudor-dark">{project.name}</h3>
                  <p class="mt-2 text-sm font-extrabold text-tudor-green">{project.city}</p>
                </div>
              </div>
              <div class="mt-5 grid gap-4 text-sm leading-6 text-tudor-deep/80">
                <p><strong class="text-tudor-dark">Problème identifié :</strong> {project.problem}</p>
                <p><strong class="text-tudor-dark">Solution apportée :</strong> {project.solution}</p>
              </div>
              <div class="mt-5 flex flex-wrap gap-2">
                {project.highlights.map((highlight) => <Badge variant="peach">{highlight}</Badge>)}
              </div>
              <div class="mt-auto pt-6">
                <Button href={project.demoUrl ?? "/contact"} variant="dark" size="sm">Voir la démo</Button>
              </div>
            </Card>
          ))}
        </div>
      </Container>
    </Section>
    ) : (
      <LocalTradesSection />
    )}

    <Section id="methode" tone="soft">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div class="max-w-3xl">
            <Badge variant="green">Méthode</Badge>
            <h2 class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
              Une méthode simple pour aller vite sans vous perdre
            </h2>
            <p class="mt-5 text-lg leading-8 text-tudor-deep/80">
              Pas besoin d'avoir déjà un cahier des charges. On part de votre activité, puis on avance avec une projection concrète.
            </p>
          </div>
          <Card variant="light" class="overflow-hidden p-4">
            <img
              src="/assets/etapes-du-projet.png"
              alt="Illustration des étapes d'un projet de site vitrine"
              class="h-64 w-full rounded-md object-cover object-center sm:h-80"
              loading="lazy"
            />
          </Card>
        </div>
        <div class="mt-12 grid gap-5 lg:grid-cols-5">
          {processSteps.map((step, index) => (
            <Card interactive class="relative">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-tudor-dark font-display text-sm font-black text-tudor-cream">
                {index + 1}
              </span>
              <h3 class="mt-5 font-display text-xl font-black text-tudor-dark">{step.title}</h3>
              <p class="mt-3 leading-7 text-tudor-deep/78">{step.description}</p>
            </Card>
          ))}
        </div>
      </Container>
    </Section>

    <Section id="offres" tone="cream">
      <Container>
        <div class="max-w-3xl">
          <Badge variant="green"><span data-i18n="offers.eyebrow">Offres</span></Badge>
          <h2 data-i18n="offers.title" class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
            Une offre claire adaptée à votre besoin
          </h2>
          <p data-i18n="offers.text" class="mt-5 text-lg leading-8 text-tudor-deep/80">
            Les prix donnent un repère. La recommandation finale dépend de votre activité, de vos contenus et de vos objectifs.
          </p>
        </div>
        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {pricing.map((plan) => (
            <Card variant={plan.highlighted ? "deep" : "light"} interactive class={["flex h-full flex-col", plan.highlighted ? "lg:-translate-y-3" : ""].join(" ")}>
              {plan.highlighted && <Badge variant="peach">Le plus demandé</Badge>}
              <h3 class:list={["mt-4 font-display text-3xl font-black", plan.highlighted ? "text-tudor-cream" : "text-tudor-dark"]}>{plan.name}</h3>
              <p data-i18n={`offers.plans.${plan.key}.description`} class:list={["mt-3 leading-7", plan.highlighted ? "text-tudor-cream/78" : "text-tudor-deep/78"]}>{plan.description}</p>
              <p data-i18n={`offers.plans.${plan.key}.time`} class:list={["mt-3 text-sm font-extrabold uppercase tracking-[0.14em]", plan.highlighted ? "text-tudor-peach" : "text-tudor-green"]}>{plan.timeEstimate}</p>
              <p data-i18n={`offers.plans.${plan.key}.positioning`} class:list={["mt-3 leading-7", plan.highlighted ? "text-tudor-cream/76" : "text-tudor-deep/76"]}>{plan.positioning}</p>
              <p class:list={["mt-6 font-display text-2xl font-black", plan.highlighted ? "text-tudor-peach" : "text-tudor-green"]}>{plan.price}</p>
              <ul class:list={["mt-6 grid gap-3 text-sm font-bold", plan.highlighted ? "text-tudor-cream/82" : "text-tudor-deep/82"]}>
                {plan.features.map((feature) => (
                  <li class="flex gap-3">
                    <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-tudor-peach"></span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-auto pt-8">
                <Button href="#contact" variant={plan.highlighted ? "primary" : "dark"} class="w-full">Demander ma démo</Button>
              </div>
            </Card>
          ))}
        </div>
        <Card variant="outline" class="mt-5">
          <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
              <h3 class="font-display text-2xl font-black text-tudor-dark">Maintenance optionnelle</h3>
              <p class="mt-2 text-tudor-deep/78">Suivi simple pour garder votre site propre, disponible et à jour.</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {maintenance.features.map((feature) => <li class="rounded-full bg-white/70 px-3 py-1 text-sm font-bold text-tudor-deep">{feature}</li>)}
              </ul>
            </div>
            <p class="font-display text-2xl font-black text-tudor-green">{maintenance.price}</p>
          </div>
        </Card>
      </Container>
    </Section>

    <Section id="difference" tone="green" class="overflow-hidden">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-stretch">
          <Card variant="deep" class="relative overflow-hidden p-8 md:p-10">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_12%,rgba(255,196,157,0.18),transparent_28%)]"></div>
            <div class="relative">
              <Badge variant="peach"><span data-i18n="why.eyebrow">Pourquoi travailler avec moi</span></Badge>
              <h2 data-i18n="why.title" class="mt-5 font-display text-4xl font-black leading-tight md:text-5xl">
              Plus concret qu'une promesse de site web
              </h2>
              <p data-i18n="why.text" class="mt-5 text-lg leading-8 text-tudor-cream/82">
              Vous ne payez pas seulement pour du code. Vous investissez dans une meilleure image, plus de confiance et un contact plus évident.
              </p>
              <div class="mt-8 rounded-lg bg-tudor-cream p-4">
                <img
                  src="/assets/personalisation.png"
                  alt="Illustration de la personnalisation du site selon l'activité"
                  class="h-72 w-full rounded-md object-contain"
                  loading="lazy"
                />
              </div>
            </div>
          </Card>

          <div class="grid gap-5 sm:grid-cols-2">
            {differentiators.map((item) => (
              <Card variant="deep" interactive class="min-h-56">
                <IconFeature icon={item.icon} title={item.title} description={item.description} tone="dark" />
              </Card>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <Section id="avant-apres" tone="soft">
      <Container>
        <div class="max-w-3xl">
          <Badge variant="green">Avant / Après</Badge>
          <h2 class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
            Ce que votre site doit changer
          </h2>
        </div>
        <Card variant="light" class="mt-10 overflow-hidden p-4">
          <img
            src="/assets/pub-2-avant-apres.png"
            alt="Illustration avant après d'une présence en ligne modernisée"
            class="h-64 w-full rounded-md object-cover object-center sm:h-96"
            loading="lazy"
          />
        </Card>
        <div class="mt-10 grid gap-5 lg:grid-cols-2">
          <Card variant="outline">
            <h3 class="font-display text-3xl font-black text-tudor-dark">Avant</h3>
            <ul class="mt-6 grid gap-4">
              {beforeAfter.map(([before]) => (
                <li class="rounded-md bg-white/70 p-4 font-bold text-tudor-deep/78">{before}</li>
              ))}
            </ul>
          </Card>
          <Card variant="green">
            <h3 class="font-display text-3xl font-black text-tudor-cream">Après</h3>
            <ul class="mt-6 grid gap-4">
              {beforeAfter.map(([, after]) => (
                <li class="rounded-md bg-tudor-cream p-4 font-bold text-tudor-dark">{after}</li>
              ))}
            </ul>
          </Card>
        </div>
      </Container>
    </Section>

    <Section id="faq" tone="cream">
      <Container width="lg">
        <div class="max-w-3xl">
          <Badge variant="green">FAQ</Badge>
          <h2 class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
            Les questions qui reviennent souvent
          </h2>
        </div>
        <div class="mt-10 grid gap-4">
          {faq.map((item) => (
            <details class="group rounded-lg border border-tudor-green/16 bg-white/74 p-5 shadow-[0_14px_40px_rgba(6,79,70,0.06)]">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-black text-tudor-dark focus-visible:outline-tudor-peach [&::-webkit-details-marker]:hidden">
                {item.question}
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-tudor-peach text-tudor-dark transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-4 max-w-3xl leading-7 text-tudor-deep/78">{item.answer}</p>
            </details>
          ))}
        </div>
      </Container>
    </Section>

    <Section id="contact" tone="deep">
      <Container>
        <div class="grid gap-12 lg:grid-cols-[0.88fr_1.12fr]">
          <div>
            <Badge variant="peach"><span data-i18n="contact.eyebrow">Contact</span></Badge>
            <h2 data-i18n="contact.title" class="mt-5 font-display text-4xl font-black leading-tight md:text-5xl">
              Échangeons sur votre projet
            </h2>
            <p data-i18n="contact.text" class="mt-5 text-lg leading-8 text-tudor-cream/80">
              Envoyez-moi le nom de votre activité, votre ville et ce que vous aimeriez améliorer. Je vous dirai rapidement ce qu'on peut créer pour valoriser votre image.
            </p>
            <div class="mt-8 grid gap-3 text-sm font-bold text-tudor-cream/82">
              <a class="transition hover:text-tudor-peach focus-visible:outline-tudor-peach" href="tel:+33625664448">{contact.phone}</a>
              <a class="transition hover:text-tudor-peach focus-visible:outline-tudor-peach" href={`mailto:${contact.email}`}>{contact.email}</a>
              <span>LinkedIn : {contact.linkedin}</span>
              <span>Instagram : {contact.instagram}</span>
            </div>
            <img
              src="/assets/contact-rapide.png"
              alt="Illustration d'un contact rapide depuis un site vitrine"
              class="mt-8 h-64 w-full rounded-md object-cover object-center"
              loading="lazy"
            />
          </div>

          <Card variant="light" class="p-6 md:p-8">
            <ContactForm>
              <div class="grid gap-4 md:grid-cols-2">
                <label class="block">
                  <span class="text-sm font-extrabold text-tudor-dark">Nom</span>
                  <input class="mt-2 min-h-12 w-full rounded-md border border-tudor-green/20 bg-white px-4 text-tudor-dark focus:border-tudor-green" type="text" name="nom" autocomplete="name" required />
                </label>
                <label class="block">
                  <span class="text-sm font-extrabold text-tudor-dark">Activité</span>
                  <input class="mt-2 min-h-12 w-full rounded-md border border-tudor-green/20 bg-white px-4 text-tudor-dark focus:border-tudor-green" type="text" name="activite" required />
                </label>
                <label class="block">
                  <span class="text-sm font-extrabold text-tudor-dark">Ville</span>
                  <input class="mt-2 min-h-12 w-full rounded-md border border-tudor-green/20 bg-white px-4 text-tudor-dark focus:border-tudor-green" type="text" name="ville" required />
                </label>
                <label class="block">
                  <span class="text-sm font-extrabold text-tudor-dark">Email</span>
                  <input class="mt-2 min-h-12 w-full rounded-md border border-tudor-green/20 bg-white px-4 text-tudor-dark focus:border-tudor-green" type="email" name="email" autocomplete="email" required />
                </label>
                <label class="block">
                  <span class="text-sm font-extrabold text-tudor-dark">Téléphone</span>
                  <input class="mt-2 min-h-12 w-full rounded-md border border-tudor-green/20 bg-white px-4 text-tudor-dark focus:border-tudor-green" type="tel" name="telephone" autocomplete="tel" />
                </label>
                <label class="block">
                  <span class="text-sm font-extrabold text-tudor-dark">Objectif principal</span>
                  <select class="mt-2 min-h-12 w-full rounded-md border border-tudor-green/20 bg-white px-4 text-tudor-dark focus:border-tudor-green" name="objectif">
                    {contactGoals.map((goal) => <option>{goal}</option>)}
                  </select>
                </label>
              </div>
              <label class="mt-4 block">
                <span class="text-sm font-extrabold text-tudor-dark">Site actuel ou fiche Google</span>
                <input class="mt-2 min-h-12 w-full rounded-md border border-tudor-green/20 bg-white px-4 text-tudor-dark focus:border-tudor-green" type="url" name="site-actuel" />
              </label>
              <label class="mt-4 block">
                <span class="text-sm font-extrabold text-tudor-dark">Message</span>
                <textarea class="mt-2 w-full rounded-md border border-tudor-green/20 bg-white px-4 py-3 text-tudor-dark focus:border-tudor-green" name="message" rows="5"></textarea>
              </label>
              <p class="mt-4 text-sm font-bold leading-6 text-tudor-deep/72">
                Pas besoin d'avoir déjà un cahier des charges. Envoyez-moi simplement votre activité et votre ville.
              </p>
              <Button type="submit" class="mt-5 w-full"><span data-i18n="contact.submit">Envoyer ma demande</span></Button>
            </ContactForm>
          </Card>
        </div>
      </Container>
    </Section>
  </main>

  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-tudor-green/12 bg-tudor-cream/94 p-3 shadow-[0_-12px_40px_rgba(3,59,53,0.12)] backdrop-blur md:hidden">
    <Button href="#contact" class="w-full">Demander ma démo</Button>
  </div>
</BaseLayout>
