---
import Badge from "@components/Badge.astro";
import Button from "@components/Button.astro";
import Card from "@components/Card.astro";
import ContactForm from "@components/ContactForm.astro";
import Container from "@components/Container.astro";
import IconFeature from "@components/IconFeature.astro";
import LocalTradesSection from "@components/LocalTradesSection.astro";
import Section from "@components/Section.astro";
import { siteConfig } from "../config/site";
import { contact } from "@data/contact";
import { faq } from "@data/faq";
import { maintenance, pricing } from "@data/pricing";
import { projects } from "@data/projects";
import BaseLayout from "@layouts/BaseLayout.astro";

const heroBadges = ["Démo avant engagement", "Design moderne", "SEO local", "Contact facilité"];

const problemCards = [
  "Site inexistant",
  "Image vieillissante",
  "Services peu clairs",
  "Contacts difficiles",
  "Manque de confiance",
  "Visibilité locale limitée",
];

const solutionFeatures = [
  {
    icon: "demo",
    title: "Démo avant engagement",
    description: "Vous voyez une première projection avant de vous engager.",
  },
  {
    icon: "design",
    title: "Design moderne",
    description: "Un site propre, clair et adapté à votre activité.",
  },
  {
    icon: "local",
    title: "SEO local",
    description: "Une structure pensée pour être trouvé dans votre ville.",
  },
  {
    icon: "contact",
    title: "Contact facilité",
    description: "Appel, formulaire, réservation ou itinéraire visibles au bon moment.",
  },
] as const;

const processSteps = [
  {
    title: "J'analyse votre activité",
    description: "Google Maps, avis, services, photos et concurrence locale.",
  },
  {
    title: "Je prépare une direction claire",
    description: "Message, image, structure et contenus utiles.",
  },
  {
    title: "Je crée une première démo",
    description: "Vous voyez concrètement ce que votre site peut devenir.",
  },
  {
    title: "On ajuste ensemble",
    description: "Textes, images, couleurs et appels à l'action.",
  },
  {
    title: "Je mets le site en ligne",
    description: "Site rapide, responsive, sécurisé et prêt à être partagé.",
  },
];

const differentiators = [
  {
    icon: "demo",
    title: "Vous voyez avant de décider",
    description: "La démo rend le projet concret dès le départ.",
  },
  {
    icon: "local",
    title: "Je parle le langage des clients locaux",
    description: "Pas de jargon ou de cahier technique compliqué.",
  },
  {
    icon: "contact",
    title: "Je pense image et contact",
    description: "Le site doit rassurer et déclencher l'appel, pas seulement être joli.",
  },
  {
    icon: "design",
    title: "Je personnalise vraiment",
    description: "Chaque vitrine part du métier, des avis, de la ville et des objectifs.",
  },
] as const;

const beforeAfter = [
  ["Une fiche Google seule", "Une vitrine claire"],
  ["Un site ancien", "Une image plus professionnelle"],
  ["Peu d'explications", "Des services mieux compris"],
  ["Une image floue", "Une confiance renforcée"],
  ["Des contacts qui se perdent", "Des appels plus faciles"],
];

const solutionIconPaths: Record<string, string> = {
  demo: "M8 5v14l11-7-11-7Zm14 7a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z",
  design: "M4 5h16v11H4V5Zm4 15h8m-4-4v4M8 9h8m-8 4h5",
  local: "M12 22s7-5.2 7-12a7 7 0 1 0-14 0c0 6.8 7 12 7 12Zm0-9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
  contact: "M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.3 19.3 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z",
};

const contactGoals = [
  "Avoir un site moderne",
  "Recevoir plus d'appels",
  "Améliorer mon image",
  "Présenter mes services",
  "Rediriger vers une réservation",
  "Être plus visible localement",
  "Voir une démo",
];

---

<BaseLayout>
  <main>
    <!-- HERO -->
    <section id="accueil" class="relative overflow-hidden bg-[var(--page-bg)]">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_82%_16%,rgba(255,196,157,0.24),transparent_30%),radial-gradient(circle_at_6%_84%,rgba(14,143,120,0.10),transparent_24%)]"></div>
      <div aria-hidden="true" class="surface-grid pointer-events-none absolute inset-0 opacity-[0.20]"></div>

      <Container>
        <div class="relative grid min-h-[calc(100vh-6rem)] items-center gap-10 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">

          <!-- LEFT: value proposition -->
          <div class="fade-up">
            <Badge variant="peach">
              <span data-i18n="hero.eyebrow">Sites modernes pour professionnels locaux</span>
            </Badge>

            <h1
              data-i18n="hero.title"
              class="mt-6 font-display text-5xl font-black leading-[1.03] text-tudor-dark sm:text-6xl xl:text-[4.75rem]"
            >
              Une vitrine qui travaille pour vous
            </h1>

            <p
              data-i18n="hero.subtitle"
              class="mt-6 max-w-lg text-lg leading-8 text-tudor-deep/82 xl:text-xl"
            >
              Je crée des sites vitrines modernes pour professionnels locaux, pensés pour rassurer vos futurs clients, valoriser votre activité et faciliter la prise de contact.
            </p>

            <div class="mt-9 flex flex-wrap gap-3">
              <Button href="#contact" size="lg">
                <span data-i18n="hero.primaryCta">Demander ma démo</span>
              </Button>
              <Button href="#exemples" variant="outline" size="lg">
                <span data-i18n="hero.secondaryCta">Voir les exemples</span>
              </Button>
            </div>

            <ul
              class="mt-10 grid grid-cols-2 gap-x-6 gap-y-3 sm:flex sm:flex-wrap sm:gap-x-8 sm:gap-y-3"
              data-i18n-list="hero.badges"
            >
              {heroBadges.map((badge) => (
                <li class="flex items-center gap-2.5">
                  <span aria-hidden="true" class="h-2 w-2 shrink-0 rounded-full bg-tudor-peach"></span>
                  <span data-i18n-item class="text-sm font-bold text-tudor-deep">{badge}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- RIGHT: dark showcase panel -->
          <div class="fade-up delay-2 relative lg:py-10">

            <!-- Floating card: Démo incluse (desktop only) -->
            <div class="absolute -right-3 -top-6 z-10 hidden lg:block">
              <div class="rounded-2xl border border-tudor-green/16 bg-white/92 px-4 py-3 shadow-[0_12px_40px_rgba(3,59,53,0.14)] backdrop-blur-sm">
                <p class="text-[0.68rem] font-black uppercase tracking-[0.14em] text-tudor-green">
                  <span data-i18n="hero.cards.0.label">Démo incluse</span>
                </p>
                <p class="mt-0.5 font-display text-base font-black text-tudor-dark">
                  <span data-i18n="hero.cards.0.value">avant engagement</span>
                </p>
              </div>
            </div>

            <!-- Floating card: livraison rapide (desktop only) -->
            <div class="absolute -bottom-6 -left-3 z-10 hidden items-center gap-3 rounded-2xl border border-tudor-green/16 bg-white/92 px-4 py-3 shadow-[0_12px_40px_rgba(3,59,53,0.14)] backdrop-blur-sm lg:flex">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-tudor-peach text-tudor-dark">
                <svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current stroke-[2.5]" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span class="text-sm font-black text-tudor-dark">
                <span data-i18n="hero.cards.1.value">Site livré en quelques jours</span>
              </span>
            </div>

            <!-- Dark showcase panel (no card-within-card) -->
            <div class="relative overflow-hidden rounded-3xl bg-tudor-dark shadow-[0_50px_120px_rgba(3,59,53,0.28)]">
              <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_88%_10%,rgba(255,196,157,0.20),transparent_26%),radial-gradient(circle_at_12%_88%,rgba(14,143,120,0.28),transparent_24%)]"></div>

              <!-- Panel header: logo identity, featured and large -->
              <div class="relative flex items-center justify-between px-6 pt-6 pb-4">
                <div class="flex items-center gap-4">
                  <img
                    src="/assets/logo-tudor-pop-transparent.png"
                    alt="Logo Tudor Pop"
                    class="h-16 w-16 object-contain"
                  />
                  <div>
                    <p class="font-display text-xl font-black text-tudor-cream">Tudor Pop</p>
                    <p class="text-xs font-bold text-tudor-peach">Sites vitrines locaux</p>
                  </div>
                </div>
                <span class="rounded-full border border-tudor-peach/30 bg-tudor-peach/16 px-3 py-1.5 text-xs font-black text-tudor-peach">
                  Demo
                </span>
              </div>

              <div class="mx-6 h-px bg-white/10"></div>

              <!-- Image directly on dark bg — no inner frame -->
              <div class="px-5 pt-4 pb-3">
                <img
                  src="/assets/la-vitrine-et-les-plus.png"
                  alt="Aperçu d'un site vitrine moderne pour commerce local"
                  class="h-[18rem] w-full rounded-2xl object-contain sm:h-[22rem] lg:h-[22rem]"
                  loading="eager"
                  fetchpriority="high"
                />
              </div>

              <!-- Stats strip -->
              <div class="relative mx-4 mb-4 grid grid-cols-3 rounded-2xl bg-white/6 py-3">
                <div class="flex flex-col items-center gap-1 border-r border-white/10 px-3">
                  <span class="font-display text-xl font-black text-tudor-peach">48h</span>
                  <span class="text-center text-[0.65rem] font-bold leading-tight text-tudor-cream/58">
                    <span data-i18n="hero.stats.0.label">Première démo</span>
                  </span>
                </div>
                <div class="flex flex-col items-center gap-1 border-r border-white/10 px-3">
                  <span class="font-display text-xl font-black text-tudor-cream">100%</span>
                  <span class="text-center text-[0.65rem] font-bold leading-tight text-tudor-cream/58">
                    <span data-i18n="hero.stats.1.label">Personnalisé</span>
                  </span>
                </div>
                <div class="flex flex-col items-center gap-1 px-3">
                  <span class="font-display text-xl font-black text-tudor-peach">Local</span>
                  <span class="text-center text-[0.65rem] font-bold leading-tight text-tudor-cream/58">
                    <span data-i18n="hero.stats.2.label">SEO & contenu</span>
                  </span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </Container>
    </section>

    <Section id="probleme" tone="soft">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
          <div class="max-w-3xl">
            <Badge variant="green"><span data-i18n="problem.eyebrow">Le vrai sujet</span></Badge>
            <h2 data-i18n="problem.title" class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
              Vos clients vous regardent déjà en ligne
            </h2>
            <p data-i18n="problem.text" class="mt-5 text-lg leading-8 text-tudor-deep/80">
              Avant d'appeler, réserver ou passer vous voir, vos futurs clients regardent votre image en ligne. Une fiche Google seule ne suffit pas toujours à rassurer, expliquer et donner envie.
            </p>
          </div>
          <Card variant="light" class="overflow-hidden p-4">
            <img
              src="/assets/site-internet.png"
              alt="Illustration d'un site internet clair pour une activité locale"
              class="h-64 w-full rounded-md object-contain bg-tudor-soft sm:h-80"
              loading="lazy"
            />
          </Card>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-i18n-list="problem.cards">
          {problemCards.map((problem) => (
            <Card interactive>
              <div class="flex items-center gap-3">
                <span class="h-3 w-3 rounded-full bg-tudor-peach"></span>
                <h3 data-i18n-item class="font-display text-xl font-black">{problem}</h3>
              </div>
            </Card>
          ))}
        </div>
      </Container>
    </Section>

    <Section id="solution" tone="deep" class="overflow-hidden">
      <Container>
        <div class="grid gap-12 lg:grid-cols-[1fr_0.78fr] lg:items-center">
          <div>
            <Badge variant="peach"><span data-i18n="solution.eyebrow">La solution</span></Badge>
            <h2 data-i18n="solution.title" class="mt-5 font-display text-4xl font-black leading-tight md:text-5xl">
              Je transforme votre présence en ligne en vraie vitrine commerciale
            </h2>
            <p data-i18n="solution.text" class="mt-5 max-w-2xl text-lg leading-8 text-tudor-cream/78">
              Un site clair, moderne et pensé pour convertir. Votre activité devient plus compréhensible, plus crédible et plus simple à contacter.
            </p>
            <div class="mt-8">
              <Button href="#contact"><span data-i18n="solution.cta">Voir ce que mon site pourrait donner</span></Button>
            </div>
          </div>

          <div class="rounded-2xl border border-white/10 bg-tudor-cream/8 p-5">
            <img
              src="/assets/avantages-du-projet.png"
              alt="Illustration des avantages d'un site vitrine professionnel"
              class="h-64 w-full rounded-xl object-contain sm:h-80 lg:h-[22rem]"
              loading="lazy"
            />
          </div>
        </div>

        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {solutionFeatures.map((feature, index) => (
            <article class="rounded-xl border border-white/12 bg-tudor-dark/42 p-6">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-tudor-peach text-tudor-dark shadow-[0_8px_22px_rgba(255,196,157,0.28)]">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current stroke-2">
                  <path d={solutionIconPaths[feature.icon]} stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <h3 data-i18n={`solution.features.${index}.title`} class="mt-4 font-display text-lg font-black leading-snug text-tudor-cream">
                {feature.title}
              </h3>
              <p data-i18n={`solution.features.${index}.description`} class="mt-2 leading-7 text-tudor-cream/72">
                {feature.description}
              </p>
            </article>
          ))}
        </div>
      </Container>
    </Section>

    {siteConfig.showClientProjects ? (
    <Section id="exemples" tone="cream">
      <Container>
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div class="max-w-3xl">
            <Badge variant="green">Exemples et réalisations</Badge>
            <h2 class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
              Des exemples pensés pour de vrais professionnels locaux
            </h2>
            <p class="mt-5 text-lg leading-8 text-tudor-deep/80">
              Chaque démonstration part d'un métier, d'une ville et d'un objectif clair : rassurer plus vite et faciliter le contact.
            </p>
          </div>
          <Button href="/realisations" variant="outline">Toutes les réalisations</Button>
        </div>

        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {projects.map((project) => (
            <Card variant="light" interactive class="flex h-full flex-col">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <Badge variant="outline">{project.sector}</Badge>
                  <h3 class="mt-4 font-display text-2xl font-black leading-tight text-tudor-dark">{project.name}</h3>
                  <p class="mt-2 text-sm font-extrabold text-tudor-green">{project.city}</p>
                </div>
              </div>
              <div class="mt-5 grid gap-4 text-sm leading-6 text-tudor-deep/80">
                <p><strong class="text-tudor-dark">Problème identifié :</strong> {project.problem}</p>
                <p><strong class="text-tudor-dark">Solution apportée :</strong> {project.solution}</p>
              </div>
              <div class="mt-5 flex flex-wrap gap-2">
                {project.highlights.map((highlight) => <Badge variant="peach">{highlight}</Badge>)}
              </div>
              <div class="mt-auto pt-6">
                <Button href={project.demoUrl ?? "/contact"} variant="dark" size="sm">Voir la démo</Button>
              </div>
            </Card>
          ))}
        </div>
      </Container>
    </Section>
    ) : (
      <LocalTradesSection />
    )}

    <Section id="methode" tone="soft">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div class="max-w-3xl">
            <Badge variant="green"><span data-i18n="method.eyebrow">Méthode</span></Badge>
            <h2 data-i18n="method.title" class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
              Une méthode simple pour aller vite sans vous perdre
            </h2>
            <p data-i18n="method.text" class="mt-5 text-lg leading-8 text-tudor-deep/80">
              Pas besoin d'avoir déjà un cahier des charges. On part de votre activité, puis on avance avec une projection concrète.
            </p>
          </div>
          <Card variant="light" class="overflow-hidden p-4">
            <img
              src="/assets/etapes-du-projet.png"
              alt="Illustration des étapes d'un projet de site vitrine"
              class="h-64 w-full rounded-md object-contain bg-tudor-soft sm:h-80"
              loading="lazy"
            />
          </Card>
        </div>
        <div class="mt-12 grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5">
          {processSteps.map((step, index) => (
            <Card interactive class="relative">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-tudor-peach font-display text-sm font-black text-tudor-dark">
                {index + 1}
              </span>
              <h3 data-i18n={`method.steps.${index}.title`} class="mt-5 font-display text-lg font-black text-tudor-dark">{step.title}</h3>
              <p data-i18n={`method.steps.${index}.description`} class="mt-3 leading-7 text-tudor-deep/78">{step.description}</p>
            </Card>
          ))}
        </div>
        <div class="mt-10 flex justify-center">
          <Button href="#contact" variant="dark"><span data-i18n="hero.primaryCta">Demander ma démo</span></Button>
        </div>
      </Container>
    </Section>

    <Section id="offres" tone="cream">
      <Container>
        <div class="max-w-3xl">
          <Badge variant="green"><span data-i18n="offers.eyebrow">Offres</span></Badge>
          <h2 data-i18n="offers.title" class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
            Une offre claire adaptée à votre besoin
          </h2>
          <p data-i18n="offers.text" class="mt-5 text-lg leading-8 text-tudor-deep/80">
            Les prix donnent un repère. La recommandation finale dépend de votre activité, de vos contenus et de vos objectifs.
          </p>
        </div>
        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {pricing.map((plan) => (
            <Card variant={plan.highlighted ? "deep" : "light"} interactive class={["flex h-full flex-col", plan.highlighted ? "lg:-translate-y-3" : ""].join(" ")}>
              {plan.highlighted && <Badge variant="peach"><span data-i18n="offers.popular">Le plus demandé</span></Badge>}
              <h3 class:list={["mt-4 font-display text-3xl font-black", plan.highlighted ? "text-tudor-cream" : "text-tudor-dark"]}>{plan.name}</h3>
              <p data-i18n={`offers.plans.${plan.key}.description`} class:list={["mt-3 leading-7", plan.highlighted ? "text-tudor-cream/78" : "text-tudor-deep/78"]}>{plan.description}</p>
              <p data-i18n={`offers.plans.${plan.key}.time`} class:list={["mt-3 text-sm font-extrabold uppercase tracking-[0.14em]", plan.highlighted ? "text-tudor-peach" : "text-tudor-green"]}>{plan.timeEstimate}</p>
              <p data-i18n={`offers.plans.${plan.key}.positioning`} class:list={["mt-3 leading-7", plan.highlighted ? "text-tudor-cream/76" : "text-tudor-deep/76"]}>{plan.positioning}</p>
              <p class:list={["mt-6 font-display text-2xl font-black", plan.highlighted ? "text-tudor-peach" : "text-tudor-green"]}>{plan.price}</p>
              <ul class:list={["mt-6 grid gap-3 text-sm font-bold", plan.highlighted ? "text-tudor-cream/82" : "text-tudor-deep/82"]}>
                {plan.features.map((feature) => (
                  <li class="flex gap-3">
                    <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-tudor-peach"></span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-auto pt-8">
                <Button href="#contact" variant={plan.highlighted ? "primary" : "dark"} class="w-full"><span data-i18n="offers.demoCta">Demander ma démo</span></Button>
              </div>
            </Card>
          ))}
        </div>
        <Card variant="outline" class="mt-5">
          <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
              <h3 data-i18n="offers.maintenance.title" class="font-display text-2xl font-black text-tudor-dark">Maintenance optionnelle</h3>
              <p data-i18n="offers.maintenance.text" class="mt-2 text-tudor-deep/78">Suivi simple pour garder votre site propre, disponible et à jour.</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {maintenance.features.map((feature) => <li class="rounded-full bg-white/70 px-3 py-1 text-sm font-bold text-tudor-deep">{feature}</li>)}
              </ul>
            </div>
            <p class="font-display text-2xl font-black text-tudor-green">{maintenance.price}</p>
          </div>
        </Card>
      </Container>
    </Section>

    <Section id="difference" tone="green" class="overflow-hidden">
      <Container>
        <div class="max-w-3xl">
          <Badge variant="peach"><span data-i18n="why.eyebrow">Pourquoi travailler avec moi</span></Badge>
          <h2 data-i18n="why.title" class="mt-5 font-display text-4xl font-black leading-tight text-tudor-cream md:text-5xl">
            Plus concret qu'une promesse de site web
          </h2>
          <p data-i18n="why.text" class="mt-5 text-lg leading-8 text-tudor-cream/82">
            Vous ne payez pas seulement pour du code. Vous investissez dans une meilleure image, plus de confiance et un contact plus évident.
          </p>
        </div>

        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {differentiators.map((item, index) => (
            <article class="rounded-xl border border-white/12 bg-tudor-dark/52 p-6">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-tudor-peach text-tudor-dark shadow-[0_8px_22px_rgba(255,196,157,0.28)]">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current stroke-2">
                  <path d={solutionIconPaths[item.icon]} stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <h3 data-i18n={`why.features.${index}.title`} class="mt-4 font-display text-lg font-black leading-snug text-tudor-cream">{item.title}</h3>
              <p data-i18n={`why.features.${index}.description`} class="mt-2 leading-7 text-tudor-cream/72">{item.description}</p>
            </article>
          ))}

          <article class="relative overflow-hidden rounded-xl border border-tudor-peach/28 bg-tudor-cream p-6 text-tudor-dark sm:col-span-2 lg:col-span-2">
            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_88%_50%,rgba(255,196,157,0.26),transparent_38%)]"></div>
            <div class="relative flex flex-col gap-6 md:flex-row md:items-center">
              <div class="flex-1">
                <Badge variant="green"><span data-i18n="why.glossary.eyebrow">Comprendre le web</span></Badge>
                <h3 data-i18n="why.glossary.title" class="mt-4 font-display text-2xl font-black leading-snug text-tudor-dark md:text-3xl">
                  Je rends le web plus simple à comprendre
                </h3>
                <p data-i18n="why.glossary.text" class="mt-3 max-w-xl leading-7 text-tudor-deep/78">
                  SEO, domaine, hébergement, responsive, formulaire… j'explique les notions importantes pour que vous sachiez ce que vous achetez.
                </p>
                <Button href="/glossaire" variant="dark" class="mt-6">
                  <span data-i18n="why.glossary.cta">Comprendre les mots du web</span>
                </Button>
              </div>
              <div class="shrink-0">
                <img
                  src="/assets/personalisation.png"
                  alt="Illustration de la personnalisation et de la transparence dans un projet web"
                  class="h-48 w-full rounded-xl object-contain md:h-56 md:w-56 lg:h-64 lg:w-64"
                  loading="lazy"
                />
              </div>
            </div>
          </article>
        </div>
      </Container>
    </Section>

    <Section id="avant-apres" tone="soft">
      <Container>
        <div class="max-w-3xl">
          <Badge variant="green"><span data-i18n="beforeAfter.eyebrow">Avant / Après</span></Badge>
          <h2 data-i18n="beforeAfter.title" class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
            Ce que votre site doit changer
          </h2>
        </div>
        <Card variant="light" class="mt-10 overflow-hidden p-4">
          <img
            src="/assets/pub-2-avant-apres.png"
            alt="Illustration avant après d'une présence en ligne modernisée"
            class="h-64 w-full rounded-md object-contain bg-tudor-soft sm:h-80"
            loading="lazy"
          />
        </Card>
        <div class="mt-10 grid gap-5 lg:grid-cols-2">
          <Card variant="outline">
            <h3 data-i18n="beforeAfter.before" class="font-display text-3xl font-black text-tudor-dark">Avant</h3>
            <ul class="mt-6 grid gap-4">
              {beforeAfter.map(([before], index) => (
                <li data-i18n={`beforeAfter.items.${index}.before`} class="rounded-md bg-white/70 p-4 font-bold text-tudor-deep/78">{before}</li>
              ))}
            </ul>
          </Card>
          <Card variant="green">
            <h3 data-i18n="beforeAfter.after" class="font-display text-3xl font-black text-tudor-cream">Après</h3>
            <ul class="mt-6 grid gap-4">
              {beforeAfter.map(([, after], index) => (
                <li data-i18n={`beforeAfter.items.${index}.after`} class="rounded-md bg-tudor-cream p-4 font-bold text-tudor-dark">{after}</li>
              ))}
            </ul>
          </Card>
        </div>
      </Container>
    </Section>

    <Section id="faq" tone="cream">
      <Container width="lg">
        <div class="max-w-3xl">
          <Badge variant="green"><span data-i18n="faq.eyebrow">FAQ</span></Badge>
          <h2 data-i18n="faq.title" class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
            Les questions qui reviennent souvent
          </h2>
        </div>
        <div class="mt-10 grid gap-4">
          {faq.map((item) => (
            <details class="group rounded-lg border border-tudor-green/16 bg-white/74 p-5 shadow-[0_14px_40px_rgba(6,79,70,0.06)]">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-black text-tudor-dark focus-visible:outline-tudor-peach [&::-webkit-details-marker]:hidden">
                {item.question}
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-tudor-peach text-tudor-dark transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-4 max-w-3xl leading-7 text-tudor-deep/78">{item.answer}</p>
            </details>
          ))}
        </div>
      </Container>
    </Section>

    <Section id="contact" tone="deep">
      <Container>
        <div class="grid gap-12 lg:grid-cols-[0.88fr_1.12fr]">
          <div>
            <Badge variant="peach"><span data-i18n="contact.eyebrow">Contact</span></Badge>
            <h2 data-i18n="contact.title" class="mt-5 font-display text-4xl font-black leading-tight md:text-5xl">
              Échangeons sur votre projet
            </h2>
            <p data-i18n="contact.text" class="mt-5 text-lg leading-8 text-tudor-cream/80">
              Envoyez-moi le nom de votre activité, votre ville et ce que vous aimeriez améliorer. Je vous dirai rapidement ce qu'on peut créer pour valoriser votre image.
            </p>
            <div class="mt-8 grid gap-3 text-sm font-bold text-tudor-cream/82">
              <a class="transition hover:text-tudor-peach focus-visible:outline-tudor-peach" href="tel:+33625664448">{contact.phone}</a>
              <a class="transition hover:text-tudor-peach focus-visible:outline-tudor-peach" href={`mailto:${contact.email}`}>{contact.email}</a>
              <span>LinkedIn : {contact.linkedin}</span>
              <span>Instagram : {contact.instagram}</span>
            </div>
            <img
              src="/assets/contact-rapide.png"
              alt="Illustration d'un contact rapide depuis un site vitrine"
              class="mt-8 h-64 w-full rounded-md object-contain"
              loading="lazy"
            />
          </div>

          <Card variant="light" class="p-6 md:p-8">
            <ContactForm>
              <div class="grid gap-4 md:grid-cols-2">
                <label class="block">
                  <span data-i18n="contact.fields.name" class="text-sm font-extrabold text-tudor-dark">Nom</span>
                  <input class="mt-2 min-h-12 w-full rounded-md border border-tudor-green/20 bg-tudor-cream/90 px-4 text-tudor-dark focus:border-tudor-green" type="text" name="nom" autocomplete="name" required />
                </label>
                <label class="block">
                  <span data-i18n="contact.fields.activity" class="text-sm font-extrabold text-tudor-dark">Activité</span>
                  <input class="mt-2 min-h-12 w-full rounded-md border border-tudor-green/20 bg-tudor-cream/90 px-4 text-tudor-dark focus:border-tudor-green" type="text" name="activite" required />
                </label>
                <label class="block">
                  <span data-i18n="contact.fields.city" class="text-sm font-extrabold text-tudor-dark">Ville</span>
                  <input class="mt-2 min-h-12 w-full rounded-md border border-tudor-green/20 bg-tudor-cream/90 px-4 text-tudor-dark focus:border-tudor-green" type="text" name="ville" required />
                </label>
                <label class="block">
                  <span data-i18n="contact.fields.email" class="text-sm font-extrabold text-tudor-dark">Email</span>
                  <input class="mt-2 min-h-12 w-full rounded-md border border-tudor-green/20 bg-tudor-cream/90 px-4 text-tudor-dark focus:border-tudor-green" type="email" name="email" autocomplete="email" required />
                </label>
                <label class="block">
                  <span data-i18n="contact.fields.phone" class="text-sm font-extrabold text-tudor-dark">Téléphone</span>
                  <input class="mt-2 min-h-12 w-full rounded-md border border-tudor-green/20 bg-tudor-cream/90 px-4 text-tudor-dark focus:border-tudor-green" type="tel" name="telephone" autocomplete="tel" />
                </label>
                <label class="block">
                  <span data-i18n="contact.fields.goal" class="text-sm font-extrabold text-tudor-dark">Objectif principal</span>
                  <select class="mt-2 min-h-12 w-full rounded-md border border-tudor-green/20 bg-tudor-cream/90 px-4 text-tudor-dark focus:border-tudor-green" name="objectif">
                    {contactGoals.map((goal, i) => <option data-i18n={`contact.goals.${i}`}>{goal}</option>)}
                  </select>
                </label>
              </div>
              <label class="mt-4 block">
                <span data-i18n="contact.fields.currentSite" class="text-sm font-extrabold text-tudor-dark">Site actuel ou fiche Google</span>
                <input class="mt-2 min-h-12 w-full rounded-md border border-tudor-green/20 bg-tudor-cream/90 px-4 text-tudor-dark focus:border-tudor-green" type="url" name="site-actuel" />
              </label>
              <label class="mt-4 block">
                <span data-i18n="contact.fields.message" class="text-sm font-extrabold text-tudor-dark">Message</span>
                <textarea class="mt-2 w-full rounded-md border border-tudor-green/20 bg-tudor-cream/90 px-4 py-3 text-tudor-dark focus:border-tudor-green" name="message" rows="5"></textarea>
              </label>
              <p data-i18n="contact.fields.hint" class="mt-4 text-sm font-bold leading-6 text-tudor-deep/72">
                Pas besoin d'avoir déjà un cahier des charges. Envoyez-moi simplement votre activité et votre ville.
              </p>
              <Button type="submit" class="mt-5 w-full"><span data-i18n="contact.submit">Envoyer ma demande</span></Button>
            </ContactForm>
          </Card>
        </div>
      </Container>
    </Section>
  </main>

  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-tudor-green/12 bg-tudor-cream/94 p-3 shadow-[0_-12px_40px_rgba(3,59,53,0.12)] backdrop-blur md:hidden">
    <Button href="#contact" class="w-full">Demander ma démo</Button>
  </div>
</BaseLayout>
