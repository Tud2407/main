---
type Variant = "primary" | "secondary" | "outline" | "ghost" | "dark";
type Size = "sm" | "md" | "lg";
type ButtonType = "button" | "submit" | "reset";

type Props = {
  href?: string;
  variant?: Variant;
  size?: Size;
  type?: ButtonType;
  ariaLabel?: string;
  class?: string;
};

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  ariaLabel,
  class: className,
} = Astro.props;

const sizeClasses: Record<Size, string> = {
  sm: "btn-sm",
  md: "btn-md",
  lg: "btn-lg",
};

const classes = ["btn", `btn-${variant}`, sizeClasses[size], className];
---

{
  href ? (
    <a href={href} aria-label={ariaLabel} class:list={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} aria-label={ariaLabel} class:list={classes}>
      <slot />
    </button>
  )
}
