---
import Button from "@components/Button.astro";
import Container from "@components/Container.astro";

const navItems = [
  { label: "Accueil", href: "/" },
  { label: "Offres", href: "/offres" },
  { label: "Méthode", href: "/methode" },
  { label: "Glossaire", href: "/glossaire" },
  { label: "Contact", href: "/contact" },
];

const sectorItems = [
  { label: "Commerces locaux", href: "/sites-pour-commerces-locaux" },
  { label: "Restaurants", href: "/sites-pour-restaurants" },
  { label: "Garages", href: "/sites-pour-garages" },
  { label: "Cabinets médicaux", href: "/sites-pour-cabinets-medicaux" },
];
---

<header class="sticky top-0 z-50 border-b border-tudor-green/12 bg-tudor-cream/90 shadow-[0_10px_30px_rgba(6,79,70,0.06)] backdrop-blur-xl">
  <Container>
    <div class="flex min-h-24 items-center justify-between gap-4">
      <a href="/" class="group flex items-center gap-4 rounded-full focus-visible:outline-tudor-peach" aria-label="Accueil Tudor Pop">
        <img
          src="/assets/logo-tudor-pop-transparent.png"
          alt=""
          class="h-14 w-14 rounded-full object-contain transition group-hover:scale-105 sm:h-16 sm:w-16"
        />
        <span class="leading-tight">
          <span class="block font-display text-lg font-black text-tudor-dark sm:text-xl">Tudor Pop</span>
          <span data-i18n="header.tagline" class="block text-xs font-bold uppercase tracking-[0.16em] text-tudor-green sm:text-[0.8rem]">Sites vitrines</span>
        </span>
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigation principale">
        {
          navItems.slice(0, 2).map((item) => (
            <a
              href={item.href}
              class="rounded-full px-4 py-2 text-sm font-extrabold text-tudor-deep transition hover:bg-tudor-green/10 hover:text-tudor-dark focus-visible:outline-tudor-peach"
            >
              {item.label}
            </a>
          ))
        }

        <!-- Métiers dropdown -->
        <div class="group relative">
          <button
            type="button"
            class="flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-extrabold text-tudor-deep transition hover:bg-tudor-green/10 hover:text-tudor-dark focus-visible:outline-tudor-peach"
            aria-haspopup="true"
          >
            Métiers
            <svg
              class="h-3.5 w-3.5 transition duration-200 group-hover:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
            <div class="min-w-[200px] overflow-hidden rounded-xl border border-tudor-green/14 bg-tudor-cream shadow-[0_20px_60px_rgba(3,59,53,0.18)]">
              {
                sectorItems.map((item) => (
                  <a
                    href={item.href}
                    class="block px-5 py-3 text-sm font-extrabold text-tudor-deep transition hover:bg-tudor-green/10 hover:text-tudor-dark focus-visible:outline-tudor-peach"
                  >
                    {item.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        {
          navItems.slice(2).map((item) => (
            <a
              href={item.href}
              class="rounded-full px-4 py-2 text-sm font-extrabold text-tudor-deep transition hover:bg-tudor-green/10 hover:text-tudor-dark focus-visible:outline-tudor-peach"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-3 lg:flex">
        <button type="button" class="site-toggle" data-theme-toggle aria-label="Changer le thème">
          <span data-theme-label>Clair</span>
        </button>
        <button type="button" class="site-toggle" data-lang-toggle aria-label="Changer la langue">
          <span data-lang-label>EN</span>
        </button>
        <Button href="tel:+33625664448" variant="ghost" size="sm"><span data-i18n="nav.call">Appeler</span></Button>
        <Button href="/contact" size="sm"><span data-i18n="nav.demo">Demander ma démo</span></Button>
      </div>

      <details class="group relative lg:hidden">
        <summary class="flex h-12 w-12 cursor-pointer list-none items-center justify-center rounded-full bg-tudor-dark text-tudor-cream transition hover:bg-tudor-deep focus-visible:outline-tudor-peach [&::-webkit-details-marker]:hidden">
          <span class="sr-only">Ouvrir le menu</span>
          <span class="h-0.5 w-5 rounded-full bg-current shadow-[0_7px_0_current,0_-7px_0_current]"></span>
        </summary>
        <div class="absolute right-0 top-16 w-[min(88vw,22rem)] rounded-lg border border-tudor-green/16 bg-tudor-cream p-3 shadow-[0_20px_70px_rgba(3,59,53,0.18)]">
          <div class="mb-3 grid grid-cols-2 gap-2">
            <button type="button" class="site-toggle w-full" data-theme-toggle aria-label="Changer le thème">
              <span data-theme-label>Clair</span>
            </button>
            <button type="button" class="site-toggle w-full" data-lang-toggle aria-label="Changer la langue">
              <span data-lang-label>EN</span>
            </button>
          </div>
          <nav class="grid gap-1" aria-label="Navigation mobile">
            {
              navItems.slice(0, 2).map((item) => (
                <a
                  href={item.href}
                  class="rounded-md px-4 py-3 font-extrabold text-tudor-deep transition hover:bg-tudor-green/10 hover:text-tudor-dark focus-visible:outline-tudor-peach"
                >
                  {item.label}
                </a>
              ))
            }
            <!-- Métiers section mobile -->
            <details class="group/sectors rounded-md">
              <summary class="flex cursor-pointer list-none items-center justify-between rounded-md px-4 py-3 font-extrabold text-tudor-deep transition hover:bg-tudor-green/10 hover:text-tudor-dark [&::-webkit-details-marker]:hidden">
                <span>Métiers</span>
                <svg class="h-4 w-4 transition group-open/sectors:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <div class="ml-4 mt-1 grid gap-1 border-l-2 border-tudor-green/20 pl-3">
                {
                  sectorItems.map((item) => (
                    <a
                      href={item.href}
                      class="rounded-md px-3 py-2.5 text-sm font-extrabold text-tudor-deep/80 transition hover:bg-tudor-green/10 hover:text-tudor-dark"
                    >
                      {item.label}
                    </a>
                  ))
                }
              </div>
            </details>
            {
              navItems.slice(2).map((item) => (
                <a
                  href={item.href}
                  class="rounded-md px-4 py-3 font-extrabold text-tudor-deep transition hover:bg-tudor-green/10 hover:text-tudor-dark focus-visible:outline-tudor-peach"
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <div class="mt-3 grid gap-2 border-t border-tudor-green/12 pt-3">
            <Button href="/contact" class="w-full"><span data-i18n="nav.demo">Demander ma démo</span></Button>
            <Button href="tel:+33625664448" variant="dark" class="w-full"><span data-i18n="nav.callLong">Appeler Tudor</span></Button>
          </div>
        </div>
      </details>
    </div>
  </Container>
</header>
