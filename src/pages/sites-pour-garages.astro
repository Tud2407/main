---
import Badge from "@components/Badge.astro";
import Button from "@components/Button.astro";
import Card from "@components/Card.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Site vitrine pour garage — Inspirer confiance et générer des demandes | Tudor Pop"
  description="Un site vitrine moderne pour votre garage : présenter vos services, mettre en avant vos avis, faciliter les demandes de devis et être trouvé sur Google dans votre ville."
>
  <main>
    <Section tone="cream" class="surface-grid overflow-hidden">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <Badge variant="green">Garages &amp; mécaniciens</Badge>
            <h1
              class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-6xl"
            >
              Un site vitrine qui inspire confiance et génère des demandes de devis
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-tudor-deep/80">
              Vos clients cherchent un garagiste de confiance avant d'appeler. Un site clair, avec vos services, vos avis et vos coordonnées, fait toute la différence.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <Button href="/contact">Demander ma démo</Button>
              <Button href="/offres" variant="outline">Voir les offres</Button>
            </div>
          </div>
          <Card variant="deep" class="relative overflow-hidden p-8">
            <div
              class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_80%_10%,rgba(255,196,157,0.2),transparent_30%)]"
            >
            </div>
            <div class="relative">
              <p class="text-sm font-black uppercase tracking-[0.16em] text-tudor-peach">
                Ce que vos clients voient
              </p>
              <div class="mt-6 grid gap-3">
                {
                  [
                    "Vos services détaillés",
                    "Vos avis clients visibles",
                    "Demande de devis en un clic",
                    "Localisation et horaires",
                    "Image professionnelle renforcée",
                  ].map((item) => (
                    <div class="flex items-center gap-3 rounded-lg border border-white/10 bg-tudor-dark/42 px-4 py-3">
                      <span class="h-2 w-2 shrink-0 rounded-full bg-tudor-peach" />
                      <span class="text-sm font-bold text-tudor-cream">{item}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          </Card>
        </div>
      </Container>
    </Section>

    <Section tone="soft">
      <Container>
        <div class="max-w-3xl">
          <Badge variant="green">Le problème</Badge>
          <h2 class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
            Pourquoi une fiche Google ne suffit plus
          </h2>
          <p class="mt-5 text-lg leading-8 text-tudor-deep/80">
            Avant de confier leur voiture, vos clients potentiels font des recherches. Ils veulent voir clairement qui vous êtes, ce que vous faites et pourquoi vous choisir plutôt qu'un autre.
          </p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            [
              {
                title: "Image insuffisante",
                text: "Une fiche Google seule ne montre pas vos compétences, votre équipe ni votre spécialité.",
              },
              {
                title: "Services peu clairs",
                text: "Sans page dédiée, vos clients ne savent pas exactement ce que vous proposez.",
              },
              {
                title: "Contact compliqué",
                text: "Un numéro seul ne suffit pas. Les clients veulent une demande de devis rapide.",
              },
              {
                title: "Manque de confiance",
                text: "Sans avis visibles ni présentation claire, le doute s'installe face à la concurrence.",
              },
              {
                title: "Pas de différenciation",
                text: "Votre spécialité (diesel, électrique, carrosserie...) n'est pas mise en avant.",
              },
              {
                title: "Visibilité locale limitée",
                text: "Sans site structuré, Google ne vous positionne pas bien dans les recherches locales.",
              },
            ].map((item) => (
              <Card interactive>
                <h3 class="font-display text-lg font-black text-tudor-dark">{item.title}</h3>
                <p class="mt-3 leading-7 text-tudor-deep/78">{item.text}</p>
              </Card>
            ))
          }
        </div>
      </Container>
    </Section>

    <Section tone="deep" class="overflow-hidden">
      <Container>
        <div class="max-w-3xl">
          <Badge variant="peach">Ce qu'un site vous apporte</Badge>
          <h2 class="mt-5 font-display text-4xl font-black leading-tight md:text-5xl">
            Votre garage mérite une vraie vitrine
          </h2>
          <p class="mt-5 text-lg leading-8 text-tudor-cream/80">
            Un site bien conçu pour un garage, c'est plus de confiance, plus d'appels et une image professionnelle renforcée dès la première visite.
          </p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          {
            [
              {
                title: "Présenter vos services clairement",
                text: "Révision, carrosserie, pneus, diagnostic… Chaque service expliqué simplement pour que vos clients comprennent immédiatement ce que vous faites.",
              },
              {
                title: "Afficher vos avis pour rassurer",
                text: "Vos avis Google mis en valeur sur votre site pour renforcer la confiance avant le premier appel.",
              },
              {
                title: "Faciliter la prise de contact",
                text: "Bouton appel, formulaire de demande de devis et lien vers Google Maps directement accessibles depuis n'importe quelle page.",
              },
              {
                title: "Être trouvé sur Google localement",
                text: "Structure SEO pensée pour apparaître sur des recherches comme « garage [votre ville] ».",
              },
            ].map((item) => (
              <article class="rounded-xl border border-white/12 bg-tudor-dark/42 p-6">
                <h3 class="font-display text-lg font-black text-tudor-cream">{item.title}</h3>
                <p class="mt-3 leading-7 text-tudor-cream/72">{item.text}</p>
              </article>
            ))
          }
        </div>
      </Container>
    </Section>

    <Section tone="cream">
      <Container>
        <div class="max-w-3xl">
          <Badge variant="green">Contenu recommandé</Badge>
          <h2 class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-5xl">
            Ce que doit contenir votre site de garage
          </h2>
          <p class="mt-5 text-lg leading-8 text-tudor-deep/80">
            Chaque section joue un rôle précis pour rassurer et déclencher le contact.
          </p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            [
              {
                num: "01",
                title: "Accroche forte",
                text: "Un titre clair, votre spécialité, vos valeurs et un bouton de contact visible immédiatement.",
              },
              {
                num: "02",
                title: "Vos services détaillés",
                text: "Listez vos prestations avec des descriptions courtes et rassurantes.",
              },
              {
                num: "03",
                title: "Vos avantages",
                text: "Ce qui vous distingue : rapidité, devis gratuit, équipe expérimentée, marques traitées.",
              },
              {
                num: "04",
                title: "Avis clients visibles",
                text: "Intégrez vos meilleurs avis Google pour asseoir votre crédibilité.",
              },
              {
                num: "05",
                title: "Localisation & horaires",
                text: "Carte, adresse, horaires et accès clairs pour les clients qui veulent venir.",
              },
              {
                num: "06",
                title: "Contact direct",
                text: "Bouton d'appel, formulaire de devis et lien Maps facilement accessibles.",
              },
            ].map((item) => (
              <Card interactive>
                <span class="font-display text-sm font-black text-tudor-peach">{item.num}</span>
                <h3 class="mt-3 font-display text-lg font-black text-tudor-dark">{item.title}</h3>
                <p class="mt-2 leading-7 text-tudor-deep/78">{item.text}</p>
              </Card>
            ))
          }
        </div>
      </Container>
    </Section>

    <Section tone="deep">
      <Container>
        <Card
          variant="green"
          class="grid gap-8 p-8 md:grid-cols-[1fr_auto] md:items-center md:p-10"
        >
          <div>
            <Badge variant="peach">Votre projet</Badge>
            <h2
              class="mt-5 font-display text-3xl font-black leading-tight text-tudor-cream md:text-4xl"
            >
              Voyez à quoi ressemblerait votre site avant de décider.
            </h2>
            <p class="mt-4 max-w-2xl text-lg leading-8 text-tudor-cream/82">
              Envoyez-moi le nom de votre garage et votre ville. Je prépare une démo concrète sans engagement.
            </p>
          </div>
          <Button href="/contact" size="lg">Demander ma démo</Button>
        </Card>
      </Container>
    </Section>

    <Section tone="soft">
      <Container>
        <p class="text-sm font-extrabold uppercase tracking-[0.14em] text-tudor-green">
          Autres secteurs
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <Button href="/sites-pour-restaurants" variant="outline" size="sm">Restaurants</Button>
          <Button href="/sites-pour-commerces-locaux" variant="outline" size="sm">Commerces locaux</Button>
          <Button href="/sites-pour-cabinets-medicaux" variant="outline" size="sm">Cabinets médicaux</Button>
        </div>
      </Container>
    </Section>
  </main>
</BaseLayout>
