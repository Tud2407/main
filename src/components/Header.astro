---
import Button from "@components/Button.astro";
import Container from "@components/Container.astro";

const navItems = [
  { label: "Accueil", href: "/" },
  { label: "Exemples", href: "/#exemples" },
  { label: "Offres", href: "/#offres" },
  { label: "Méthode", href: "/#methode" },
  { label: "FAQ", href: "/#faq" },
  { label: "Contact", href: "/contact" },
];
---

<header class="sticky top-0 z-50 border-b border-tudor-green/12 bg-tudor-cream/88 shadow-[0_10px_30px_rgba(6,79,70,0.06)] backdrop-blur-xl">
  <Container>
    <div class="flex min-h-20 items-center justify-between gap-4">
      <a href="/" class="group flex items-center gap-3 rounded-full focus-visible:outline-tudor-peach" aria-label="Accueil Tudor Pop">
        <img
          src="/assets/logo-tudor-pop-transparent.png"
          alt=""
          class="h-11 w-11 rounded-full object-contain transition group-hover:scale-105"
        />
        <span class="leading-tight">
          <span class="block font-display text-base font-black text-tudor-dark">Tudor Pop</span>
          <span class="block text-xs font-bold uppercase tracking-[0.16em] text-tudor-green">Sites vitrines</span>
        </span>
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigation principale">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="rounded-full px-4 py-2 text-sm font-extrabold text-tudor-deep transition hover:bg-tudor-green/10 hover:text-tudor-dark focus-visible:outline-tudor-peach"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-3 lg:flex">
        <Button href="tel:+33625664448" variant="ghost" size="sm">Appeler</Button>
        <Button href="/contact" size="sm">Demander ma démo</Button>
      </div>

      <details class="group relative lg:hidden">
        <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full bg-tudor-dark text-tudor-cream transition hover:bg-tudor-deep focus-visible:outline-tudor-peach [&::-webkit-details-marker]:hidden">
          <span class="sr-only">Ouvrir le menu</span>
          <span class="h-0.5 w-5 rounded-full bg-current shadow-[0_7px_0_current,0_-7px_0_current]"></span>
        </summary>
        <div class="absolute right-0 top-14 w-[min(88vw,22rem)] rounded-lg border border-tudor-green/16 bg-tudor-cream p-3 shadow-[0_20px_70px_rgba(3,59,53,0.18)]">
          <nav class="grid gap-1" aria-label="Navigation mobile">
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  class="rounded-md px-4 py-3 font-extrabold text-tudor-deep transition hover:bg-tudor-green/10 hover:text-tudor-dark focus-visible:outline-tudor-peach"
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <div class="mt-3 grid gap-2 border-t border-tudor-green/12 pt-3">
            <Button href="/contact" class="w-full">Demander ma démo</Button>
            <Button href="tel:+33625664448" variant="dark" class="w-full">Appeler Tudor</Button>
          </div>
        </div>
      </details>
    </div>
  </Container>
</header>
