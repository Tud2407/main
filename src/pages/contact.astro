---
import Badge from "@components/Badge.astro";
import Button from "@components/Button.astro";
import Card from "@components/Card.astro";
import ContactForm from "@components/ContactForm.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import { contact } from "@data/contact";
import BaseLayout from "@layouts/BaseLayout.astro";

const contactGoals = [
  "Avoir un site moderne",
  "Recevoir plus d'appels",
  "Améliorer mon image",
  "Présenter mes services",
  "Rediriger vers une réservation",
  "Être plus visible localement",
  "Voir une démo",
];

const fieldClass =
  "field-input mt-2 min-h-12 w-full rounded-md px-4 font-sans text-sm focus:outline-none";
---

<BaseLayout
  title="Contact — Parlons de votre projet de site vitrine | Tudor Pop"
  description="Envoyez-moi votre activité et votre ville. Je reviens rapidement avec une première démo concrète de votre site vitrine. Démo avant engagement, sans obligation."
>
  <main>
    <Section tone="cream" class="surface-grid overflow-hidden">
      <Container>
        <div class="max-w-xl">
          <Badge variant="green">Contact</Badge>
          <h1 class="mt-5 font-display text-4xl font-black leading-tight text-tudor-dark md:text-6xl">
            Échangeons sur votre projet
          </h1>
          <p class="mt-6 text-lg leading-8 text-tudor-deep/80">
            Envoyez-moi le nom de votre activité, votre ville et ce que vous aimeriez améliorer. Je vous dirai rapidement ce qu'on peut créer pour valoriser votre image.
          </p>
        </div>
      </Container>
    </Section>

    <Section tone="soft">
      <Container>
        <div class="grid gap-12 lg:grid-cols-[0.88fr_1.12fr]">
          <!-- Sidebar: coordonnées + étapes -->
          <div>
            <Badge variant="green">Coordonnées directes</Badge>
            <h2 class="mt-5 font-display text-2xl font-black text-tudor-dark md:text-3xl">
              Joindre Tudor directement
            </h2>
            <div class="mt-6 grid gap-4 text-sm font-bold text-tudor-deep/82">
              <a
                class="flex items-center gap-3 transition hover:text-tudor-green focus-visible:outline-tudor-peach"
                href={`tel:${contact.phone.replace(/\s/g, "")}`}
              >
                <span
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-tudor-peach text-tudor-dark"
                >
                  <svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current stroke-2" aria-hidden="true">
                    <path
                      d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.3 19.3 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </span>
                {contact.phone}
              </a>

              <a
                class="flex items-center gap-3 transition hover:text-tudor-green focus-visible:outline-tudor-peach"
                href={`mailto:${contact.email}`}
              >
                <span
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-tudor-peach text-tudor-dark"
                >
                  <svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current stroke-2" aria-hidden="true">
                    <path
                      d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                    <polyline points="22,6 12,13 2,6" stroke-linecap="round" stroke-linejoin="round"
                    ></polyline>
                  </svg>
                </span>
                {contact.email}
              </a>

              <a
                class="flex items-center gap-3 transition hover:text-tudor-green focus-visible:outline-tudor-peach"
                href={`https://www.linkedin.com/in/${contact.linkedin}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-tudor-peach text-tudor-dark"
                >
                  <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                    <path
                      d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"
                    ></path>
                    <circle cx="4" cy="4" r="2"></circle>
                  </svg>
                </span>
                LinkedIn : {contact.linkedin}
              </a>

              <a
                class="flex items-center gap-3 transition hover:text-tudor-green focus-visible:outline-tudor-peach"
                href={`https://www.instagram.com/${contact.instagram}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-tudor-peach text-tudor-dark"
                >
                  <svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current stroke-2" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-linecap="round" stroke-linejoin="round"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" stroke-linecap="round" stroke-linejoin="round"></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke-linecap="round" stroke-linejoin="round"></line>
                  </svg>
                </span>
                Instagram : @{contact.instagram}
              </a>
            </div>

            <div class="mt-10">
              <Badge variant="green">Ce qui se passe ensuite</Badge>
              <ol class="mt-5 grid gap-4">
                {
                  [
                    "Je reçois votre message et prends connaissance de votre activité.",
                    "Je reviens vers vous généralement dans la journée.",
                    "On échange brièvement pour clarifier le projet.",
                    "Je prépare une première démo concrète — sans engagement de votre part.",
                  ].map((step, i) => (
                    <li class="flex gap-4">
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-tudor-peach font-display text-sm font-black text-tudor-dark">
                        {i + 1}
                      </span>
                      <p class="pt-0.5 leading-7 text-tudor-deep/80">{step}</p>
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>

          <!-- Formulaire -->
          <Card variant="light" class="p-6 md:p-8">
            <h2 class="font-display text-2xl font-black text-tudor-dark">Votre demande de démo</h2>
            <p class="mt-2 text-sm font-bold text-tudor-deep/78">
              Pas besoin d'avoir un cahier des charges. Envoyez simplement votre activité et votre ville.
            </p>

            <ContactForm>
              <div class="mt-6 grid gap-4 md:grid-cols-2">
                <label class="block">
                  <span class="text-sm font-extrabold text-tudor-dark">Nom <span aria-hidden="true" class="text-tudor-peach">*</span></span>
                  <input
                    class={fieldClass}
                    type="text"
                    name="nom"
                    autocomplete="name"
                    required
                    aria-required="true"
                  />
                </label>

                <label class="block">
                  <span class="text-sm font-extrabold text-tudor-dark">Activité <span aria-hidden="true" class="text-tudor-peach">*</span></span>
                  <input
                    class={fieldClass}
                    type="text"
                    name="activite"
                    placeholder="Garage, restaurant, cabinet…"
                    required
                    aria-required="true"
                  />
                </label>

                <label class="block">
                  <span class="text-sm font-extrabold text-tudor-dark">Ville <span aria-hidden="true" class="text-tudor-peach">*</span></span>
                  <input
                    class={fieldClass}
                    type="text"
                    name="ville"
                    autocomplete="address-level2"
                    required
                    aria-required="true"
                  />
                </label>

                <label class="block">
                  <span class="text-sm font-extrabold text-tudor-dark">Email <span aria-hidden="true" class="text-tudor-peach">*</span></span>
                  <input
                    class={fieldClass}
                    type="email"
                    name="email"
                    autocomplete="email"
                    required
                    aria-required="true"
                  />
                </label>

                <label class="block">
                  <span class="text-sm font-extrabold text-tudor-dark">Téléphone</span>
                  <input
                    class={fieldClass}
                    type="tel"
                    name="telephone"
                    autocomplete="tel"
                  />
                </label>

                <label class="block">
                  <span class="text-sm font-extrabold text-tudor-dark">Objectif principal</span>
                  <select class={fieldClass} name="objectif">
                    {contactGoals.map((goal) => <option value={goal}>{goal}</option>)}
                  </select>
                </label>
              </div>

              <label class="mt-4 block">
                <span class="text-sm font-extrabold text-tudor-dark">Site actuel ou fiche Google</span>
                <input
                  class={fieldClass}
                  type="url"
                  name="site-actuel"
                  placeholder="https://…"
                />
              </label>

              <label class="mt-4 block">
                <span class="text-sm font-extrabold text-tudor-dark">Message</span>
                <textarea
                  class={`${fieldClass} min-h-12 py-3`}
                  name="message"
                  rows="4"
                  placeholder="Décrivez votre activité, vos objectifs ou ce que vous souhaitez améliorer…"
                ></textarea>
              </label>

              <p class="mt-4 text-xs font-bold text-tudor-deep/72">
                <span aria-hidden="true" class="text-tudor-peach">*</span> Champs obligatoires — aucun abonnement, aucun engagement.
              </p>

              <Button type="submit" class="mt-4 w-full">Envoyer ma demande</Button>
            </ContactForm>
          </Card>
        </div>
      </Container>
    </Section>
  </main>

  <!-- Mobile sticky CTA -->
  <div
    class="fixed inset-x-0 bottom-0 z-40 border-t border-tudor-green/12 bg-tudor-cream/94 p-3 shadow-[0_-12px_40px_rgba(3,59,53,0.12)] backdrop-blur md:hidden"
  >
    <a
      href={`tel:${contact.phone.replace(/\s/g, "")}`}
      class="flex w-full items-center justify-center gap-2 rounded-full bg-tudor-dark px-6 py-3.5 font-display font-black text-tudor-cream"
    >
      Appeler Tudor
    </a>
  </div>
</BaseLayout>
