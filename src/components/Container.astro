---
type Width = "sm" | "md" | "lg" | "xl";

type Props = {
  width?: Width;
  class?: string;
};

const { width = "xl", class: className } = Astro.props;

const widthClasses: Record<Width, string> = {
  sm: "max-w-3xl",
  md: "max-w-5xl",
  lg: "max-w-6xl",
  xl: "max-w-7xl",
};
---

<div class:list={["mx-auto w-full px-5 sm:px-6 lg:px-8", widthClasses[width], className]}>
  <slot />
</div>
